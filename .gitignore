# ---------------------------------------------------------------- Data (never commit)
# The M5 files are >100 MB (GitHub limit) and Kaggle's terms forbid redistribution.
data/raw/
data/processed/
# Everything else under the top-level data/ (embedded Postgres, downloads). The leading
# "/" anchors it: an unanchored "data/" would also hide src/demand_engine/data/.
/data/
# Safety net: no raw data or archives anywhere in the tree.
*.csv
*.parquet
*.zip
*.gz

# ---------------------------------------------------------------- Experiments / outputs
mlruns/
/artifacts/
*.db
*.sqlite
*.pkl
*.joblib
*.log

# ---------------------------------------------------------------- Secrets
.env
.env.*
!.env.example

