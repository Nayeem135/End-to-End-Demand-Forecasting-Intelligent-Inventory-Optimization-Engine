# Copy to .env and adjust. Every value is optional; defaults are shown.
# Nested settings use a double underscore, e.g. DATA__STATE.

SEED=42
LOG_LEVEL=INFO
LOG_FORMAT=text                   # text | json (one JSON object per line)
MLFLOW_TRACKING_URI=sqlite:///artifacts/mlflow.db   # empty disables tracking
MLFLOW_EXPERIMENT=demand-engine

# Paths (relative to the working directory)
PATHS__DATA_DIR=data              # M5 CSVs go in data/raw
PATHS__ARTIFACTS_DIR=artifacts

# Data subset
DATA__STATE=CA                    # CA | TX | WI
DATA__N_ITEMS=500
DATA__HISTORY_DAYS=730            # most recent N days; empty = all 1,941
# DATA__STORES=["CA_1","CA_2"]    # optional explicit stores

# Evaluation protocol
BACKTEST__HORIZON=28
BACKTEST__N_FOLDS=3               # validation folds (model selection, error stats)
BACKTEST__N_TEST_WINDOWS=3        # held-out test windows (reporting, simulation)
BACKTEST__MIN_TRAIN_DAYS=180

# Models
MODEL__CANDIDATES=["naive","seasonal_naive","moving_average","croston","tsb","ets","lightgbm"]
MODEL__BASELINE=moving_average
MODEL__INTERVAL_LEVEL=80
MODEL__LGBM__N_ESTIMATORS=400
MODEL__LGBM__LEARNING_RATE=0.05

# Inventory economics
INVENTORY__LEAD_TIME_DAYS=7
INVENTORY__REVIEW_PERIOD_DAYS=1
INVENTORY__SERVICE_LEVEL=0.95
INVENTORY__HOLDING_COST_RATE=0.25       # per year, fraction of unit price
INVENTORY__ORDERING_COST=10.0           # per order line
INVENTORY__STOCKOUT_COST_MULTIPLIER=1.0 # lost sale = multiplier x price
INVENTORY__BASELINE_COVER_DAYS=14       # rule-of-thumb order-up-to cover
INVENTORY__INITIAL_COVER_DAYS=14

# Database (API + publish)
DATABASE__URL=postgresql+psycopg://demand:demand@localhost:5432/demand
DATABASE__CONNECT_TIMEOUT=5

# API
API__CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# API__STATIC_DIR=frontend/dist         # serve the built dashboard from the API
